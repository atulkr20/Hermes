# ─── Server ───────────────────────────────────────────
PORT=3000
MOCK_RECEIVER_PORT=4000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5433/hermes_db

# ─── Redis ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Auth ─────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# ─── Webhook Delivery ─────────────────────────────────
MAX_RETRY_ATTEMPTS=5
REQUEST_TIMEOUT_MS=5000

# ─── Mock Receiver ─────────────────────────────────────
MERCHANT_SECRET=...............